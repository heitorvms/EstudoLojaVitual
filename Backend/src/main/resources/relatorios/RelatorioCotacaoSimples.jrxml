	<parameter name="id_cotacao" class="java.lang.Long"/>
	<parameter name="numero_cotacao" class="java.lang.String"/>
	<parameter name="cotacao_nome" class="java.lang.String"/>
	<parameter name="distribuidora_nome" class="java.lang.String"/>
	<parameter name="distribuidora_filtro" class="java.lang.String"/>
	<parameter name="cliente_nome" class="java.lang.String"/>
	<parameter name="telefone" class="java.lang.String"/>
	<parameter name="endereco_cliente" class="java.lang.String"/>
	<parameter name="quantidade_produto" class="java.lang.String"/>
	<parameter name="total_materiais" class="java.lang.Double"/>
	<parameter name="percentual_insumos" class="java.lang.Double"/>
	<parameter name="valor_insumos" class="java.lang.Double"/>
	<parameter name="valor_frete" class="java.lang.Double"/>
	<parameter name="subtotal_custo" class="java.lang.Double"/>
	<parameter name="percentual_lucro" class="java.lang.Double"/>
	<parameter name="valor_lucro" class="java.lang.Double"/>
	<parameter name="valor_total_orcamento" class="java.lang.Double"/>
	<query language="SQL"><![CDATA[SELECT
  md.descricao AS material_nome,
  m.quantidade AS quantidade,
  pmc.preco AS preco_unitario,
  (m.quantidade * pmc.preco) AS preco_total
FROM material m
JOIN material_disponivel md ON md.id = m.id_material_disponivel
JOIN preco_material_cotacao pmc ON pmc.id_material = m.id AND pmc.id_cotacao = m.id_cotacao
JOIN distribuidora d ON d.id = pmc.id_distribuidora
WHERE m.id_cotacao = $P{id_cotacao}
  AND ($P{distribuidora_filtro} IS NULL OR d.nome = $P{distribuidora_filtro})
ORDER BY md.descricao]]></query>
	<field name="material_nome" class="java.lang.String"/>
	<field name="quantidade" class="java.lang.Integer"/>
	<field name="preco_unitario" class="java.lang.Double"/>
	<field name="preco_total" class="java.lang.Double"/>
	<variable name="TOTAL_GERAL" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{preco_total}]]></expression>
	</variable>
